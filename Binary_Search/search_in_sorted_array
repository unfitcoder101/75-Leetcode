class Solution {
public:
/*
FOR else's 1st part 
arr = [8,9,10,1,2,3,4,5,6] 
target = 5

FOR else's 2nd part 
arr = [8,9,10,1,2,3,4,5,6]
target = 9

Binary search here is NOT:   find sorted array

It is:

Find WHICH SIDE is definitely sorted
Then check if target belongs there
*/
    int search(vector<int>& arr, int target) {
        int low = 0,high = arr.size()-1;
        while(low<=high){
            int mid = low + (high - low) / 2;
            if(arr[mid] == target)   return mid;
            if(arr[low] <= arr[mid])// array is sorted
            {
                if(arr[low] <= target && target <= arr[mid])    high = mid - 1;
                else low = mid + 1;
            }
            else {
                if(arr[mid]<= target && target <= arr[high])    low = mid + 1;
                else high = mid - 1;
            }
        }
        return -1;
    }
};
